# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# TypeScript v1 declaration files
typings/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Environment variables file
.env

# Credentials file
credentials.json

# SQLite auth database (runtime data, per-environment)
backend/data/

# Compiled TypeScript output
backend/dist/

# Uploaded / generated files (runtime data, per-environment)
backend/uploads/submissions/
backend/uploads/vehicles/
backend/uploads/content/
# Gallery thumbnails generated from Google Drive (backend/src/gallery/sync.ts)
backend/uploads/gallery/

# SQLite snapshots made by the backend's daily backup (backend/src/maintenance.ts)
backend/backups/

# Local reports / OS junk
lighthouse-report*.json
.DS_Store
